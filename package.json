{
  "name": "haunted-contribution-graph",
  "version": "1.0.0",
  "description": "A ghost haunts your GitHub contribution graph. Animated Halloween SVG for your profile README, generated by a GitHub Action.",
  "type": "module",
  "bin": { "haunt": "src/index.mjs" },
  "scripts": {
    "demo": "node src/index.mjs --demo --out dist",
    "frames": "node src/index.mjs --demo --themes dark --frames 72 --out frames"
  },
  "keywords": ["halloween", "github-profile", "github-action", "contribution-graph", "readme", "svg", "profile-readme", "spooky"],
  "license": "MIT",
  "engines": { "node": ">=18" }
}
